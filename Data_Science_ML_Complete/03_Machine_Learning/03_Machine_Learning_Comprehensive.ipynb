        "# Function definitionsdef split_date(df): df['Date'] = pd.to_datetime(df['Date']) df['Year'] = df.Date.dt.year df['Month'] = df.Date.dt.month df['Day'] = df.Date.dt.day df['WeekOfYear'] = df.Date.dt.isocalendar().week"

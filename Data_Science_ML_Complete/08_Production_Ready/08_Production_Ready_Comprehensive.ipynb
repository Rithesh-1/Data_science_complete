   "source": [
    "# Function definitionsdef evaluate(model, dl): # Evaluate method implementation losses, accs, f1s = [], [], [] for batch in dl: inputs, targets = batch out = model(inputs) probs = torch.sigmoid(out[:0]) loss = F.binary_cross_entropy(probs, targets.float(), weight=torch.tensor(20.)) losses.append(loss.item()) preds = (probs > 0.5).int() acc = accuracy_score(targets, preds) f1 = f1_score(targets, preds) accs.append(acc) f1s.append(f1) return np.mean(losses), np.mean(accs), np.mean(f1s) \"\"\"Evaluate model performance on test data\"\"\""
   ]

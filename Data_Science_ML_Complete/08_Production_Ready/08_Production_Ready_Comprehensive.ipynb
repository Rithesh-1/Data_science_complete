   "source": [
    "# Function definitionsdef fit(epochs, lr, model, train_loader, val_loader): # Fit method implementation optimizer = torch.optim.Adam(model.parameters(), lr, weight_decay=1e-5) history = [] # for recording epoch-wise results for epoch in range(epochs): # Training Phase for batch in train_loader: # Data loading and preprocessing inputs, targets = batch out = model(inputs) probs = torch.sigmoid(out[:0]) loss = F.binary_cross_entropy(probs, targets.float(), weight=torch.tensor(20.)) loss.backward() optimizer.step() optimizer.zero_grad() # Validation phase result = evaluate(model, val_loader) # Data loading and preprocessing loss, acc, f1 = result print('Epoch: {}; Loss: {:.4f}; Accuracy: {:.4f}; F1 Score: {:.4f}'.format( epoch, loss, acc, f1)) history.append(result) return history \"\"\"Train the model on the provided data\"\"\""
   ]

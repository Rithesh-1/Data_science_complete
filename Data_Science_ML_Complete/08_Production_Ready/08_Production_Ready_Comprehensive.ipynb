   "outputs": [],
   "source": [
    "# View an image using PILim3_path = threes[1]im3 = Image.open(im3_path)im3"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# View an image as a numpy arrayarray(im3)[4:10,4:10]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# View an image as a PyTorch tensortensor(im3)[4:10,4:10]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Overlaying pixels with the colorim3_t = tensor(im3)df = pd.DataFrame(im3_t[4:15,4:22])df.style.set_properties(**{'font-size':'6pt'}).background_gradient('Greys')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load 3s and 7s and tensorsseven_tensors = [tensor(Image.open(o)) for o in sevens]three_tensors = [tensor(Image.open(o)) for o in threes]print('No. of 3s:', len(three_tensors))print('No. of 7s:', len(seven_tensors))# Sample 3show_image(three_tensors[1]);"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Stack list of tensors into a single tensorstacked_sevens = torch.stack(seven_tensors).float()/255stacked_threes = torch.stack(three_tensors).float()/255print(stacked_threes.shape, stacked_sevens.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# View the average 3mean3 = stacked_threes.mean(0)show_image(mean3);"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# View the average 7mean7 = stacked_sevens.mean(0)show_image(mean7);"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Pick a sample '3'a_3 = stacked_threes[1]show_image(a_3);"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Use it for the entire validation set (thanks to broadcasting)valid_3_dist = mnist_distance(valid_3_tens, mean3)valid_3_dist, valid_3_dist.shape"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Predict for a single imageis_3(a_3), is_3(a_3).float()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Predict for the entire validation setis_3(valid_3_tens)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate overall accuracyaccuracy_3s = is_3(valid_3_tens).float() .mean()accuracy_7s = (1 - is_3(valid_7_tens).float()).mean()accuracy_3s,accuracy_7s,(accuracy_3s+accuracy_7s)/2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "loss = mse(preds, speed)loss"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "loss.backward()print('params:', params)print('params.grad:', params.grad)# Display results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Update the weightslr = 1e-5params.data -= lr * params.grad.dataparams.grad = None# Check the new params & lossprint('updated params:', params)preds = f(time,params)print('updated loss:', mse(preds, speed))show_preds(preds)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for i in range(10): apply_step(params)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data visualizationparams = orig_params.detach().requires_grad_()_,axs = plt.subplots(1,5,figsize=(15,3))for ax in axs: show_preds(apply_step(params, False), ax)plt.tight_layout()# Create visualization"
   ]

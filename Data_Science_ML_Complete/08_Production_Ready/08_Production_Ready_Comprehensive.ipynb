   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function definitionsdef to_device(data, device): \"\"\"Move tensor(s) to chosen device\"\"\" if isinstance(data, (list,tuple)): return [to_device(x, device) for x in data] return data.to(device, non_blocking=True)class DeviceDataLoader(): # DeviceDataLoader class definition \"\"\"Wrap a dataloader to move data to a device\"\"\" # Data loading and preprocessing def __init__(self, dl, device): self.dl = dl self.device = device def __iter__(self): \"\"\"Yield a batch of data after moving it to device\"\"\" for b in self.dl: yield to_device(b, self.device) def __len__(self): \"\"\"Number of batches\"\"\" return len(self.dl)"

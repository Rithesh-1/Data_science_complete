    "# Function definitionsdef parse_repository(article_tag): # <a> tags containing username, repository name and URL a_tags = article_tag.h1.find_all('a') # Owner's username username = a_tags[0].text.strip() # Repository name repo_name = a_tags[1].text.strip() # Repository URL repo_url = base_url + a_tags[1]['href'].strip() # Star count stars_tag = article_tag.find('a', class_='social-count float-none') star_count = parse_star_count(stars_tag.text.strip()) # Return a dictionary return { 'repository_name': repo_name, 'owner_username': username, 'stars': star_count, 'repository_url': repo_url }"
